# LLM bridge configuration — copy to .env next to docker-compose.yml.
# NEVER commit your real .env or paste real keys anywhere.

# Provider: openai | anthropic | moonshot | mistral | lmstudio | openai_compatible
LLM_PROVIDER=openai

# Your API key (leave EMPTY for lmstudio / openai_compatible local endpoints):
LLM_API_KEY=

# Optional overrides (defaults per provider are built in):
# LLM_MODEL=gpt-4o-mini                      # openai
# LLM_MODEL=claude-3-5-haiku-latest          # anthropic
# LLM_MODEL=moonshot-v1-8k                   # moonshot
# LLM_MODEL=mistral-small-latest             # mistral
# LLM_MODEL=local-model                      # lmstudio (uses the loaded model)
# LLM_BASE_URL=https://api.openai.com/v1     # override endpoint / proxy
# LLM_SYSTEM_PROMPT=You are a voice assistant. Answer briefly.
# LLM_MAX_TOKENS=300
# LLM_TEMPERATURE=0.7
# LLM_HISTORY=10
